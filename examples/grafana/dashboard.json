{
  "title": "Load test",
  "uid": "load-test-influx",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "refresh": "5s",
  "tags": [
    "load-test"
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "influxdb",
        "label": "Data source",
        "current": {}
      },
      {
        "name": "plan",
        "type": "query",
        "label": "Plan",
        "datasource": {
          "type": "influxdb",
          "uid": "${datasource}"
        },
        "query": "SHOW TAG VALUES FROM \"ballista_run\" WITH KEY = \"plan\"",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "refresh": 2,
        "current": {}
      },
      {
        "name": "scenario",
        "type": "query",
        "label": "Scenario",
        "datasource": {
          "type": "influxdb",
          "uid": "${datasource}"
        },
        "query": "SHOW TAG VALUES FROM \"ballista_requests\" WITH KEY = \"scenario\"",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "refresh": 2,
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Users",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "influxdb",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "query": "SELECT last(\"users\") FROM \"ballista_run\" WHERE \"plan\" =~ /^$plan$/ AND $timeFilter GROUP BY time($__interval) fill(none)",
          "resultFormat": "time_series",
          "datasource": {
            "type": "influxdb",
            "uid": "${datasource}"
          }
        }
      ]
    },
    {
      "id": 2,
